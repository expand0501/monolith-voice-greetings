; Monolith Voice Greetings by Expand
; Greeting lines of other factions for Monolith stalkers (whose own greeting files are silent).
; Played by mvg_greet.script. avail_communities names no real community, so no NPC gets these
; sounds at spawn: the script adds them to one Monolith stalker only when he greets you.
; mvg_<voice>_<1|3>     = walking past (same settings as vanilla [meet_hello])
; mvg_<voice>_<1|3>_dlg = dialog opens with Dialog Greetings (same settings as its [dlg_greet_hello])
; _1 = voice without a mask, _3 = the same lines through a gas mask (vanilla convention).
; Included automatically by misc\sound\script_sound.ltx (#include "script_sound_*.ltx").

; Sin, no mask
[mvg_greh_1]
type = npc
avail_communities = mvg_on_demand
npc_prefix = false
path = human\greh_1\states\meet\meet_hello_
shuffle = rnd
idle = 7,10,100

[mvg_greh_1_dlg]
type = npc
avail_communities = mvg_on_demand
npc_prefix = false
path = human\greh_1\states\meet\meet_hello_
shuffle = rnd
idle = 0,0,100
play_always = true

